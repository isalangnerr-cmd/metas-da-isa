# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). A chave "publishable"/anon é pública por design:
# quem protege os dados são as políticas RLS das migrações.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# Opcional: chave pública VAPID para notificações push (veja docs/PUSH.md)
VITE_VAPID_PUBLIC_KEY=
